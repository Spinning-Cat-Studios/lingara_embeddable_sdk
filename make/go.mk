# go/ — the Go server kit, module github.com/Spinning-Cat-Studios/lingara_embeddable_sdk/go,
# package lingaraembed (ADR 1.10.26af D2).
#
# It joins ES_LANGS as `go`. Its one require is the lingara library (D1,
# pinned by module_test.go). The ES harness (`go/conformance-es`) and the
# snippets (`snippets/server/go`) are modules of their own, each with a
# replace onto `go/`, so the kit's module zip carries neither and its go.mod
# names no replace. A nested module is outside its parent's `./...`, so the
# targets below name all three.
#
# GOTOOLCHAIN defaults to `local` for every entry point: under Go's default,
# `auto`, a go.mod may switch the toolchain, and CI's Go 1.23 leg would
# silently run something newer.
#
# Two make rules the conformance line depends on (S2's make/go.mk):
#   - $(GO_ES_HARNESS) is .PHONY, so it is rebuilt on every run: an existing
#     binary would otherwise never see a kit edit. Go's build cache keeps the
#     rebuild cheap.
#   - conformance-es-go is never .PHONY. GNU make skips the implicit-rule
#     search for a phony target, which would silently drop the recipe of the
#     conformance-es-% pattern rule in make/conformance.mk.

ES_LANGS += go

export GOTOOLCHAIN ?= local

GO ?= go
GOFMT ?= gofmt
GO_DIR := go
GO_MODULES := go go/conformance-es snippets/server/go
GO_SNIPPETS := snippets/server/go
GO_SNIPPET_KEYS := mint deletePlayer webhook widgetSnippet
GO_ES_HARNESS := target/go-embed-es-harness
GO_VERSION_FILE := $(GO_DIR)/version_gen.go
# golangci-lint runs only where it is installed (CI installs it; a laptop
# need not). Its budgets are go/.golangci.yml's.
GOLANGCI_LINT ?= golangci-lint

CONFORMANCE_HARNESS_es_go = $(abspath $(GO_ES_HARNESS))

.PHONY: codegen-go check-codegen-go test-go lint-go help-go $(GO_ES_HARNESS)

# version_gen.go's text from VERSION, on stdout (D1): the only place the
# kit's version lives.
GO_VERSION_TEXT = printf '%s\n' \
  '// Code generated by make codegen-go from VERSION. DO NOT EDIT.' \
  '' \
  'package lingaraembed' \
  '' \
  '// Version is this kit'"'"'s release: the embed trio'"'"'s one VERSION (ADR' \
  '// 1.10.26af D1). The default element script is pinned to it.' \
  "const Version = \"$$(tr -d '[:space:]' < VERSION)\""

## go/version_gen.go from VERSION.
codegen-go:
	@$(GO_VERSION_TEXT) > $(GO_VERSION_FILE)
	@echo "✓ wrote $(GO_VERSION_FILE)"

## Fails on any byte of difference from a fresh codegen, written into a
## temporary file, never over the working tree.
check-codegen-go:
	@tmp=$$(mktemp); $(GO_VERSION_TEXT) > $$tmp; \
	if diff -u $(GO_VERSION_FILE) $$tmp; then status=0; else status=1; fi; rm -f $$tmp; \
	if [ $$status -ne 0 ]; then echo "✗ $(GO_VERSION_FILE) is stale: run make codegen-go"; exit 1; fi; \
	echo "✓ $(GO_VERSION_FILE) is current"

## gofmt and vet over the three modules (the snippets build with vet), the
## snippets' regions, the kit's unit tests under the race detector, and
## golangci-lint when it is installed.
test-go:
	@unformatted=$$($(GOFMT) -l $(GO_MODULES)); \
	if [ -n "$$unformatted" ]; then echo "✗ gofmt -l:"; echo "$$unformatted"; exit 1; fi
	@for m in $(GO_MODULES); do echo "go vet: $$m"; $(GO) -C $$m vet ./... || exit 1; done
	@for k in $(GO_SNIPPET_KEYS); do \
	  n=$$(cat $(GO_SNIPPETS)/*.go | grep -c "^[[:space:]]*// lingara:begin $$k$$"); \
	  if [ "$$n" != 1 ]; then echo "✗ snippets: key $$k is in $$n regions"; exit 1; fi; \
	done; \
	grep -q '{{version}}' $(GO_SNIPPETS)/install.sh || { echo "✗ snippets: install.sh has no {{version}}"; exit 1; }; \
	if grep -nE 'lgr_[a-z]+_[A-Za-z0-9]{8,}' $(GO_SNIPPETS)/*; then echo "✗ snippets: a credential"; exit 1; fi; \
	echo "✓ snippets/server/go: install, $(GO_SNIPPET_KEYS)"
	$(GO) -C $(GO_DIR) test -race ./...
	@if command -v $(GOLANGCI_LINT) >/dev/null 2>&1; then $(MAKE) --no-print-directory lint-go; \
	  else echo "· golangci-lint is not installed: lint-go skipped (gofmt and vet ran)"; fi

## golangci-lint (the budgets in go/.golangci.yml) over the kit, its harness
## and its snippets.
lint-go:
	cd $(GO_DIR) && $(GOLANGCI_LINT) run ./...
	cd $(GO_DIR)/conformance-es && $(GOLANGCI_LINT) run --config ../.golangci.yml ./...
	cd $(GO_SNIPPETS) && $(GOLANGCI_LINT) run --config $(abspath $(GO_DIR))/.golangci.yml ./...

$(GO_ES_HARNESS):
	$(GO) -C $(GO_DIR)/conformance-es build -o $(abspath $(GO_ES_HARNESS)) .

## Every ES case through the Go kit. The recipe is make/conformance.mk's
## pattern rule; not .PHONY (see the header).
conformance-es-go: $(GO_ES_HARNESS)

help-go:
	@echo ""
	@echo "Go (lingaraembed):"
	@echo "  make test-go             - gofmt, vet over the kit, harness and snippets; unit tests under -race; lint-go if installed"
	@echo "  make lint-go             - golangci-lint: the budgets in go/.golangci.yml"
	@echo "  make conformance-es-go   - Every ES case through the Go kit"
	@echo "  make codegen-go          - Regenerate go/version_gen.go from VERSION"
	@echo "  make check-codegen-go    - Fail when go/version_gen.go is stale"

HELP_SECTIONS += go
