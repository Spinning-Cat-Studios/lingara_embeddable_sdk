# php/ — the Composer package spinningcatstudios/lingara-embed, namespace
# Lingara\Embed\ (ADR 1.10.26af): the PHP server kit, over the lingara
# library and nothing else.
#
# It joins ES_LANGS as `php`. Its harness runs twice (D13), once per PSR-7
# implementation the webhook receiver builds its request with: nyholm/psr7
# (with the library on Symfony HttpClient) and guzzlehttp/psr7 (with the
# library on Guzzle). make/conformance.mk has no variant mechanism, so
# conformance-es-php is spelled here with its own recipe, which overrides
# the pattern rule and runs the conformance server once per variant, both
# reporting `--lang php`. CONFORMANCE_HARNESS_es_php names the first
# variant, for `check-conformance-coverage`.
#
# php/src/Version.php is generated from VERSION (D1): PHP has no manifest
# version a program can read at run time.

ES_LANGS += php

PHP ?= php
COMPOSER ?= composer
PHP_DIR := php
PHP_VENDOR := $(PHP_DIR)/vendor/autoload.php
PHP_VERSION_FILE := $(PHP_DIR)/src/Version.php
PHP_SNIPPETS := snippets/server/php
PHP_ES_VARIANTS := nyholm guzzle
PHP_ES_HARNESS = $(PHP) $(PHP_DIR)/conformance-es/serve.php

CONFORMANCE_HARNESS_es_php = $(PHP_ES_HARNESS) nyholm

.PHONY: codegen-php check-codegen-php test-php conformance-es-php lock-php help-php

# The lockfile is a prerequisite only when it exists: the first install
# writes it.
$(PHP_VENDOR): $(PHP_DIR)/composer.json $(wildcard $(PHP_DIR)/composer.lock)
	$(COMPOSER) --working-dir=$(PHP_DIR) install --no-interaction --no-progress
	@touch $@

# Version.php's text, from VERSION, on stdout.
define php_version_file
printf '%s\n' '<?php' '' '// Generated by `make codegen-php` from VERSION. DO NOT EDIT.' '' \
  'declare(strict_types=1);' '' 'namespace Lingara\Embed;' '' 'final class Version' '{' \
  '    /** This kit'"'"'s release: the default elementSrc reads it, and so does the snippet vectors'"'"' {{version}}. */' \
  "    public const VERSION = '$$(cat VERSION)';" '}'
endef

## php/src/Version.php from VERSION.
codegen-php:
	@$(php_version_file) > $(PHP_VERSION_FILE)

## Fails when php/src/Version.php differs from a fresh codegen.
check-codegen-php:
	@if ! $(php_version_file) | diff -u $(PHP_VERSION_FILE) -; then \
	  echo "✗ $(PHP_VERSION_FILE) is stale: run make codegen-php"; exit 1; fi; \
	  echo "✓ $(PHP_VERSION_FILE) is current"

## PHPUnit, PHPStan (which also type-checks the harness and snippets/server/php
## against the kit), the PHPCS budgets, and the snippets' syntax.
test-php: $(PHP_VENDOR)
	cd $(PHP_DIR) && vendor/bin/phpunit
	cd $(PHP_DIR) && vendor/bin/phpstan analyse --no-progress --memory-limit=1G
	cd $(PHP_DIR) && vendor/bin/phpcs
	@for f in $(PHP_SNIPPETS)/*.php; do $(PHP) -l $$f > /dev/null || exit 1; done; echo "✓ $(PHP_SNIPPETS) parses"

## composer.lock's lingara library at exactly LIBRARY_FLOOR (ADR 30.10.26a):
## the floor is what the kit promises, so it is what the suite runs against.
lock-php:
	$(COMPOSER) --working-dir=$(PHP_DIR) update "spinningcatstudios/lingara:$$(tr -d '[:space:]' < LIBRARY_FLOOR)" \
	  --with-dependencies --minimal-changes --no-interaction --no-progress

## Every ES case, once on nyholm/psr7 and once on guzzlehttp/psr7.
conformance-es-php: $(PHP_VENDOR)
	@for v in $(PHP_ES_VARIANTS); do \
	  echo "conformance-es-php: $$v"; \
	  $(CONFORMANCE_SERVER) run --tier es --lang php --registry $(SPEC_REGISTRY) -- $(PHP_ES_HARNESS) $$v || exit 1; \
	done

help-php:
	@echo ""
	@echo "PHP (spinningcatstudios/lingara-embed):"
	@echo "  make test-php             - PHPUnit, PHPStan, the PHPCS budgets, snippets/server/php"
	@echo "  make conformance-es-php   - Every ES case, on nyholm/psr7 and on guzzlehttp/psr7"
	@echo "  make lock-php             - composer.lock's lingara library at exactly LIBRARY_FLOOR"
	@echo "  make codegen-php          - php/src/Version.php from VERSION"
	@echo "  make check-codegen-php    - Fail when php/src/Version.php is stale"

HELP_SECTIONS += php
