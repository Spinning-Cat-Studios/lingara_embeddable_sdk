# ruby/ — the gem `lingara-embed`, the Ruby server kit (ADR 1.10.26af).
#
# Its one runtime dependency is the `lingara` library. version.rb is the only
# generated file: `codegen-ruby` writes it from VERSION (D1), with the
# lockfiles' own version lines, and `check-codegen-ruby` fails on a byte of
# difference. Both bundles install under ruby/vendor/bundle (gitignored by
# the root's `vendor/`), never into the user's gems. The harness's receiver
# runs on rack + webrick from ruby/conformance-es/Gemfile, a bundle of its
# own, so neither server ever reaches the gem's manifest.
# conformance-es-ruby is never .PHONY: GNU make skips the implicit-rule search
# for a phony target, which would silently drop the recipe of the
# conformance-es-% pattern rule in make/conformance.mk.

ES_LANGS += ruby

RUBY ?= ruby
BUNDLE ?= bundle
RUBY_DIR := ruby
RUBY_VERSION_RB := $(RUBY_DIR)/lib/lingara/embed/version.rb
RUBY_BUNDLE_PATH := $(abspath $(RUBY_DIR)/vendor/bundle)
RUBY_ES_GEMFILE := $(abspath $(RUBY_DIR)/conformance-es/Gemfile)
RUBY_BUNDLE := BUNDLE_PATH=$(RUBY_BUNDLE_PATH) BUNDLE_GEMFILE=$(abspath $(RUBY_DIR)/Gemfile) $(BUNDLE)
RUBY_ES_BUNDLE := BUNDLE_PATH=$(RUBY_BUNDLE_PATH) BUNDLE_GEMFILE=$(RUBY_ES_GEMFILE) $(BUNDLE)
# Each Gemfile.lock records the gem's own version, and a frozen bundle (CI's)
# refuses a lockfile that disagrees with version.rb, so their version lines
# are generated with it.
RUBY_LOCKS := $(RUBY_DIR)/Gemfile.lock $(RUBY_DIR)/conformance-es/Gemfile.lock
RUBY_SNIPPETS := snippets/server/ruby

# version.rb from VERSION (ARGV[0]) into ARGV[1]: the SemVer the default
# elementSrc reads, and RubyGems' `.pre.` spelling the gemspec uses.
RUBY_WRITE_VERSION = $(RUBY) -e 'v = File.read(ARGV[0]).strip; File.write(ARGV[1], \
  "\# frozen_string_literal: true\n\n\# Generated by make codegen-ruby from VERSION. DO NOT EDIT.\n\n" \
  "module Lingara\n  module Embed\n    \# This kit release, SemVer: the default elementSrc reads it.\n" \
  "    VERSION = \"\#{v}\"\n\n    \# The same version in the RubyGems spelling the gemspec uses.\n" \
  "    GEM_VERSION = \"\#{v.sub("-", ".pre.")}\"\n  end\nend\n")'
RUBY_GEM_VERSION = $(RUBY) -I$(RUBY_DIR)/lib -rlingara/embed/version -e 'print Lingara::Embed::GEM_VERSION'

CONFORMANCE_HARNESS_es_ruby = env $(RUBY_ES_BUNDLE) exec $(RUBY) $(RUBY_DIR)/conformance-es/harness.rb

.PHONY: codegen-ruby check-codegen-ruby test-ruby ruby-bundle ruby-es-bundle help-ruby

## version.rb from VERSION, then the lockfiles' version lines.
codegen-ruby:
	$(RUBY_WRITE_VERSION) VERSION $(RUBY_VERSION_RB)
	@v=$$($(RUBY_GEM_VERSION)) && for f in $(RUBY_LOCKS); do \
	  [ ! -f $$f ] || $(RUBY) -e 'f = ARGV[0]; File.write(f, File.read(f).sub(/^    lingara-embed \(.+\)$$/, "    lingara-embed (#{ARGV[1]})"))' $$f "$$v"; \
	done

## Fails when version.rb or a lockfile's version line is not what codegen-ruby writes.
check-codegen-ruby:
	@tmp=$$(mktemp -d); status=0; \
	$(RUBY_WRITE_VERSION) VERSION $$tmp/version.rb && diff -u $(RUBY_VERSION_RB) $$tmp/version.rb || status=1; \
	v=$$($(RUBY) -I$$tmp -e 'module Lingara; module Embed; end; end; load ARGV[0]; print Lingara::Embed::GEM_VERSION' $$tmp/version.rb); \
	for f in $(RUBY_LOCKS); do [ $$status -ne 0 ] || grep -qxF "    lingara-embed ($$v)" $$f || { echo "✗ $$f does not lock lingara-embed at $$v"; status=1; }; done; \
	rm -rf $$tmp; \
	if [ $$status -ne 0 ]; then echo "✗ ruby/ is stale against VERSION: run make codegen-ruby"; exit 1; fi; \
	echo "✓ ruby/lib/lingara/embed/version.rb and the lockfiles match VERSION"

ruby-bundle:
	@$(RUBY_BUNDLE) check > /dev/null || $(RUBY_BUNDLE) install

ruby-es-bundle:
	@$(RUBY_ES_BUNDLE) check > /dev/null || $(RUBY_ES_BUNDLE) install

## minitest (vectors, router, gemspec), RuboCop (standard's style and the
## budgets in ruby/.rubocop.yml) over the kit and its snippets, rbs validate,
## and the snippets parse under -w and load against the kit.
test-ruby: ruby-bundle
	cd $(RUBY_DIR) && $(RUBY_BUNDLE) exec $(RUBY) -Ilib -Itest -e 'Dir["test/*_test.rb"].sort.each { |f| require File.expand_path(f) }'
	cd $(RUBY_DIR) && $(RUBY_BUNDLE) exec rubocop
	cd $(RUBY_DIR) && $(RUBY_BUNDLE) exec rubocop -c .rubocop.yml $(abspath $(RUBY_SNIPPETS))
	cd $(RUBY_DIR) && $(RUBY_BUNDLE) exec rbs -I sig validate
	@for f in $(RUBY_SNIPPETS)/*.rb; do $(RUBY) -wc $$f > /dev/null || exit 1; done
	cd $(RUBY_DIR) && $(RUBY_BUNDLE) exec $(RUBY) -Ilib -e 'Dir["$(abspath $(RUBY_SNIPPETS))/*.rb"].sort.each { |f| require f }'
	@echo "✓ snippets/server/ruby parses under -w and loads against the kit"

## Every ES case through the Ruby kit; installs the harness's bundle first.
## No recipe of its own, and not .PHONY (see the header).
conformance-es-ruby: ruby-es-bundle

help-ruby:
	@echo ""
	@echo "Ruby (lingara-embed):"
	@echo "  make test-ruby            - minitest, RuboCop (style and budgets), rbs validate, the snippets"
	@echo "  make conformance-es-ruby  - Every ES case through the Ruby kit (rack + webrick receiver)"
	@echo "  make codegen-ruby         - Write ruby/lib/lingara/embed/version.rb and the lockfiles' version lines from VERSION"
	@echo "  make check-codegen-ruby   - Fail when version.rb or a lockfile is stale against VERSION"

HELP_SECTIONS += ruby
