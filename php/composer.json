{
    "name": "spinningcatstudios/lingara-embed",
    "description": "The official Lingara embed server kit for PHP: mint player tokens, route signed webhooks to your players, and render the widget snippet.",
    "type": "library",
    "license": "MIT",
    "keywords": ["lingara", "language-learning", "embed", "webhooks", "psr-7"],
    "homepage": "https://getlingara.com",
    "require": {
        "php": ">=8.2",
        "spinningcatstudios/lingara": "^0.2.0-alpha.6"
    },
    "require-dev": {
        "guzzlehttp/guzzle": "^7.9",
        "guzzlehttp/psr7": "^2.7",
        "nyholm/psr7": "^1.8",
        "nyholm/psr7-server": "^1.1",
        "phpstan/phpstan": "^2.2.1",
        "phpunit/phpunit": "^11.5",
        "slevomat/coding-standard": "^8.15",
        "squizlabs/php_codesniffer": "^3.10",
        "symfony/http-client": "^7.1"
    },
    "suggest": {
        "symfony/http-client": "The HTTP client the lingara library sends through, with nyholm/psr7",
        "guzzlehttp/guzzle": "Another HTTP client the lingara library sends through"
    },
    "autoload": {
        "psr-4": {
            "Lingara\\Embed\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Lingara\\Embed\\Tests\\": "tests/"
        }
    },
    "config": {
        "platform": {
            "php": "8.2.0"
        },
        "allow-plugins": {
            "dealerdirect/phpcodesniffer-composer-installer": false
        },
        "sort-packages": true
    },
    "minimum-stability": "alpha",
    "prefer-stable": true
}
