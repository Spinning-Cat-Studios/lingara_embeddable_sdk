<Project Sdk="Microsoft.NET.Sdk">
  <!--
    xUnit over the real host library (ADR 1.10.26aa D12): `make ffi-host` builds
    it under target/debug/ and Directory.Build.props copies it beside this
    assembly. The shape vector, the header and the schema are linked as content,
    so these tests read the very files the Rust side is held to.
  -->
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <IsPackable>false</IsPackable>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <LingaraCopyHostNative>true</LingaraCopyHostNative>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.11.1" />
    <PackageReference Include="xunit" Version="2.9.2" />
    <PackageReference Include="xunit.runner.visualstudio" Version="2.8.2" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../../src/Lingara.Embed/Lingara.Embed.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="$(RepoRoot)/conformance/vectors/json-shape.json" Link="vectors/json-shape.json" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="$(RepoRoot)/ffi/include/lingara_embed.h" Link="vectors/lingara_embed.h" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="$(RepoRoot)/ffi/schema/messages.schema.json" Link="vectors/messages.schema.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
