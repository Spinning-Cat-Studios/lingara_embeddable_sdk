<Project Sdk="Microsoft.NET.Sdk">
  <!--
    The cheapest honest stand-in for IL2CPP's constraints (ADR 1.10.26aa D12):
    published under NativeAOT, where any trim or AOT warning is an error, then
    run through the offline lifecycle. It does not prove IL2CPP; AC26 does.
  -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <IsPackable>false</IsPackable>
    <PublishAot>true</PublishAot>
    <InvariantGlobalization>true</InvariantGlobalization>
    <TrimmerSingleWarn>false</TrimmerSingleWarn>
    <ILLinkTreatWarningsAsErrors>true</ILLinkTreatWarningsAsErrors>
    <IlcTreatWarningsAsErrors>true</IlcTreatWarningsAsErrors>
    <EnableTrimAnalyzer>true</EnableTrimAnalyzer>
    <EnableAotAnalyzer>true</EnableAotAnalyzer>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="../../src/Lingara.Embed/Lingara.Embed.csproj" />
  </ItemGroup>
</Project>
