{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://getlingara.com/schemas/dialogue.v1.schema.json",
  "title": "dialogue.v1",
  "description": "The one saved form of a Lingara dialogue graph (Backend ADR 28.10.26e §10): a cast of NPCs, the facts a game tracks, and checkpoints joined by edges, which may cycle. An edge's `predicate` is a game condition the embed core evaluates; its `when` is a conversational condition the server's judge evaluates; an edge with no `when` is crossed by the core alone. Every bound here is frozen for v1: a change is dialogue.v2. Keys beginning `x-` are ignored by every runtime. The byte cap (`x-maxBytes`) counts the UTF-8 bytes of the document's canonical form, `x-` keys included; that form is defined in conformance/README.md, section Dialogue IR, of the Lingara embeddable SDK. Rules this schema cannot say (unique ids, edge ids unique across the whole dialogue, `start` and every non-outcome `to` naming a checkpoint, every disclosed or predicated fact declared, predicates that parse, no cycle made only of edges without `when`, one visible line per text field) are enforced on save and on load.",
  "type": "object",
  "required": ["schema", "id", "npcs", "start", "checkpoints"],
  "additionalProperties": false,
  "patternProperties": { "^x-": {} },
  "x-maxBytes": 131072,
  "properties": {
    "schema": { "const": "dialogue.v1" },
    "id": { "$ref": "#/$defs/id" },
    "title": { "type": "string", "minLength": 1, "maxLength": 80 },
    "pedagogy": { "enum": ["subtle", "none"], "default": "subtle" },
    "npcs": { "type": "array", "items": { "$ref": "#/$defs/npc" }, "minItems": 1, "maxItems": 8 },
    "facts": { "type": "array", "items": { "$ref": "#/$defs/fact" }, "maxItems": 32, "default": [] },
    "start": { "$ref": "#/$defs/id" },
    "checkpoints": { "type": "array", "items": { "$ref": "#/$defs/checkpoint" }, "minItems": 1, "maxItems": 64 }
  },
  "$defs": {
    "id": { "type": "string", "pattern": "^[a-z][a-z0-9_]{0,47}$", "maxLength": 48 },
    "outcome": { "enum": ["success", "failure", "abandoned"] },
    "npc": {
      "type": "object",
      "required": ["id", "name"],
      "additionalProperties": false,
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "name": { "type": "string", "minLength": 1, "maxLength": 32 },
        "persona": { "type": "string", "minLength": 1, "maxLength": 120 },
        "languages": { "type": "array", "items": { "$ref": "#/$defs/language" }, "minItems": 1, "maxItems": 8 }
      }
    },
    "language": {
      "type": "object",
      "required": ["code", "speaking", "comprehension"],
      "additionalProperties": false,
      "properties": {
        "code": { "type": "string", "maxLength": 16, "pattern": "^[a-z]{2,3}(-[A-Za-z0-9]{2,8}){0,2}$" },
        "speaking": { "type": "integer", "minimum": 1, "maximum": 9 },
        "comprehension": { "type": "integer", "minimum": 1, "maximum": 9 }
      }
    },
    "fact": {
      "type": "object",
      "required": ["key", "type"],
      "additionalProperties": false,
      "properties": {
        "key": { "$ref": "#/$defs/id" },
        "type": { "enum": ["string", "number", "boolean"] },
        "default": true
      },
      "allOf": [
        {
          "if": { "properties": { "type": { "const": "string" } } },
          "then": { "properties": { "default": { "type": "string", "minLength": 1, "maxLength": 120 } } }
        },
        {
          "if": { "properties": { "type": { "const": "number" } } },
          "then": { "properties": { "default": { "type": "number" } } }
        },
        {
          "if": { "properties": { "type": { "const": "boolean" } } },
          "then": { "properties": { "default": { "type": "boolean" } } }
        }
      ]
    },
    "checkpoint": {
      "type": "object",
      "required": ["id", "goal"],
      "additionalProperties": false,
      "properties": {
        "id": { "allOf": [{ "$ref": "#/$defs/id" }, { "not": { "$ref": "#/$defs/outcome" } }] },
        "goal": { "type": "string", "minLength": 1, "maxLength": 240 },
        "may_disclose": {
          "type": "array",
          "items": { "$ref": "#/$defs/id" },
          "maxItems": 16,
          "uniqueItems": true,
          "default": []
        },
        "edges": { "type": "array", "items": { "$ref": "#/$defs/edge" }, "maxItems": 8, "default": [] }
      }
    },
    "edge": {
      "type": "object",
      "required": ["id", "to"],
      "additionalProperties": false,
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "to": { "$ref": "#/$defs/id" },
        "predicate": { "type": "string", "minLength": 1, "maxLength": 200 },
        "when": { "type": "string", "minLength": 1, "maxLength": 200 }
      }
    }
  }
}
