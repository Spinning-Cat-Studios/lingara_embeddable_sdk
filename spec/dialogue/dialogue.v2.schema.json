{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://getlingara.com/schemas/dialogue.v2.schema.json",
  "title": "dialogue.v2",
  "description": "A Lingara dialogue of either kind (Backend ADR 3.11.26h, embed ADR 3.11.26g). A static document is a dialogue.v1 graph plus named `endings`, an NPC's `disposition` (its steering stance) and a checkpoint's `steer_to`; a procedural document replaces `start` and `checkpoints` with `procedural`, the box a planner fills at run time. `endings` (1 to 8) is required in either kind, and ending ids, checkpoint ids and `abandoned` are one namespace; an edge's `to` names a checkpoint, a declared ending or `abandoned`. v1's bounds govern every member they already bound. A document v1 can say (static, endings only `success` and `failure` without labels, no `disposition`, no `steer_to`) is written and stored as dialogue.v1. Keys beginning `x-` are ignored by every runtime; the byte cap (`x-maxBytes`) counts the canonical form, `x-` keys included. Rules this schema cannot say (unique ids, targets, declared facts, predicates that parse, `steer_to` naming an edge with `when`, a topic's `discloses` within `disclosable`, the atom set, no cycle made only of edges without `when`, one visible line per text field) are enforced on save and on load.",
  "type": "object",
  "required": [
    "schema",
    "id",
    "npcs",
    "endings"
  ],
  "additionalProperties": false,
  "patternProperties": {
    "^x-": {}
  },
  "x-maxBytes": 131072,
  "properties": {
    "schema": {
      "const": "dialogue.v2"
    },
    "kind": {
      "enum": [
        "static",
        "procedural"
      ],
      "default": "static"
    },
    "id": {
      "$ref": "#/$defs/id"
    },
    "title": {
      "type": "string",
      "minLength": 1,
      "maxLength": 80
    },
    "pedagogy": {
      "enum": [
        "subtle",
        "none"
      ],
      "default": "subtle"
    },
    "npcs": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/npc"
      },
      "minItems": 1,
      "maxItems": 8
    },
    "facts": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/fact"
      },
      "maxItems": 32,
      "default": []
    },
    "endings": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/ending"
      },
      "minItems": 1,
      "maxItems": 8
    },
    "start": {
      "$ref": "#/$defs/id"
    },
    "checkpoints": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/checkpoint"
      },
      "minItems": 1,
      "maxItems": 64
    },
    "procedural": {
      "$ref": "#/$defs/procedural"
    }
  },
  "oneOf": [
    {
      "properties": {
        "kind": {
          "const": "static"
        }
      },
      "required": [
        "start",
        "checkpoints"
      ],
      "not": {
        "required": [
          "procedural"
        ]
      }
    },
    {
      "properties": {
        "kind": {
          "const": "procedural"
        }
      },
      "required": [
        "kind",
        "procedural"
      ],
      "not": {
        "anyOf": [
          {
            "required": [
              "start"
            ]
          },
          {
            "required": [
              "checkpoints"
            ]
          }
        ]
      }
    }
  ],
  "$defs": {
    "id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_]{0,47}$",
      "maxLength": 48
    },
    "ending": {
      "type": "object",
      "required": [
        "id"
      ],
      "additionalProperties": false,
      "properties": {
        "id": {
          "allOf": [
            {
              "$ref": "#/$defs/id"
            },
            {
              "not": {
                "const": "abandoned"
              }
            }
          ]
        },
        "label": {
          "type": "string",
          "minLength": 1,
          "maxLength": 80
        }
      }
    },
    "disposition": {
      "type": "object",
      "required": [
        "suggestibility",
        "initiative"
      ],
      "additionalProperties": false,
      "description": "The NPC's steering stance. suggestibility: how readily it follows the player off its goal; initiative: how hard it drives toward it (0.9 and above railroads). Each 0 to 1.",
      "properties": {
        "suggestibility": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "initiative": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        }
      }
    },
    "npc": {
      "type": "object",
      "required": [
        "id",
        "name"
      ],
      "additionalProperties": false,
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 32
        },
        "persona": {
          "type": "string",
          "minLength": 1,
          "maxLength": 120
        },
        "languages": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/language"
          },
          "minItems": 1,
          "maxItems": 8
        },
        "disposition": {
          "$ref": "#/$defs/disposition"
        }
      }
    },
    "language": {
      "type": "object",
      "required": [
        "code",
        "speaking",
        "comprehension"
      ],
      "additionalProperties": false,
      "properties": {
        "code": {
          "type": "string",
          "maxLength": 16,
          "pattern": "^[a-z]{2,3}(-[A-Za-z0-9]{2,8}){0,2}$"
        },
        "speaking": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9
        },
        "comprehension": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9
        }
      }
    },
    "fact": {
      "type": "object",
      "required": [
        "key",
        "type"
      ],
      "additionalProperties": false,
      "properties": {
        "key": {
          "$ref": "#/$defs/id"
        },
        "type": {
          "enum": [
            "string",
            "number",
            "boolean"
          ]
        },
        "default": true
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "type": {
                "const": "string"
              }
            }
          },
          "then": {
            "properties": {
              "default": {
                "type": "string",
                "minLength": 1,
                "maxLength": 120
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "type": {
                "const": "number"
              }
            }
          },
          "then": {
            "properties": {
              "default": {
                "type": "number"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "type": {
                "const": "boolean"
              }
            }
          },
          "then": {
            "properties": {
              "default": {
                "type": "boolean"
              }
            }
          }
        }
      ]
    },
    "steer_to": {
      "allOf": [
        {
          "$ref": "#/$defs/id"
        }
      ],
      "description": "An edge id of the same checkpoint that has a `when`: where the NPC drives the conversation."
    },
    "checkpoint": {
      "type": "object",
      "required": [
        "id",
        "goal"
      ],
      "additionalProperties": false,
      "properties": {
        "id": {
          "allOf": [
            {
              "$ref": "#/$defs/id"
            },
            {
              "not": {
                "const": "abandoned"
              }
            }
          ]
        },
        "goal": {
          "type": "string",
          "minLength": 1,
          "maxLength": 240
        },
        "may_disclose": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/id"
          },
          "maxItems": 16,
          "uniqueItems": true,
          "default": []
        },
        "edges": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/edge"
          },
          "maxItems": 8,
          "default": []
        },
        "steer_to": {
          "$ref": "#/$defs/steer_to"
        }
      }
    },
    "edge": {
      "type": "object",
      "required": [
        "id",
        "to"
      ],
      "additionalProperties": false,
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "to": {
          "$ref": "#/$defs/id"
        },
        "predicate": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        "when": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        }
      }
    },
    "topic": {
      "type": "object",
      "required": [
        "id",
        "about"
      ],
      "additionalProperties": false,
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "about": {
          "type": "string",
          "minLength": 1,
          "maxLength": 80
        },
        "npcs": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/id"
          },
          "maxItems": 8,
          "uniqueItems": true
        },
        "when": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        "discloses": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/id"
          },
          "maxItems": 4,
          "uniqueItems": true
        }
      }
    },
    "forbidden": {
      "type": "object",
      "required": [
        "about"
      ],
      "additionalProperties": false,
      "properties": {
        "about": {
          "type": "string",
          "minLength": 1,
          "maxLength": 80
        },
        "npcs": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/id"
          },
          "maxItems": 8,
          "uniqueItems": true
        }
      }
    },
    "goal": {
      "type": "object",
      "required": [
        "id",
        "describe"
      ],
      "additionalProperties": false,
      "anyOf": [
        {
          "required": [
            "predicate"
          ]
        },
        {
          "required": [
            "when"
          ]
        }
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "describe": {
          "type": "string",
          "minLength": 1,
          "maxLength": 60
        },
        "predicate": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        "when": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        }
      }
    },
    "atom": {
      "type": "object",
      "required": [
        "atom"
      ],
      "additionalProperties": false,
      "properties": {
        "atom": {
          "enum": [
            "open",
            "elicit",
            "reveal",
            "practise",
            "close"
          ]
        },
        "prefer": {
          "type": "number",
          "minimum": 0,
          "maximum": 1,
          "default": 0.5
        }
      }
    },
    "horizon": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "plan_depth": {
          "type": "integer",
          "minimum": 1,
          "maximum": 3,
          "default": 2
        },
        "sketch_depth": {
          "type": "integer",
          "minimum": 0,
          "maximum": 1,
          "default": 1
        },
        "max_nodes": {
          "type": "integer",
          "minimum": 3,
          "maximum": 16,
          "default": 10
        }
      }
    },
    "termination": {
      "type": "object",
      "required": [
        "max_turns",
        "max_beats"
      ],
      "additionalProperties": false,
      "properties": {
        "max_turns": {
          "type": "integer",
          "minimum": 1,
          "maximum": 200
        },
        "max_beats": {
          "type": "integer",
          "minimum": 1,
          "maximum": 64
        },
        "success": {
          "type": "object",
          "required": [
            "goal",
            "ending"
          ],
          "additionalProperties": false,
          "properties": {
            "goal": {
              "$ref": "#/$defs/id"
            },
            "ending": {
              "$ref": "#/$defs/id"
            }
          }
        },
        "stall": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "turns": {
              "type": "integer",
              "minimum": 2,
              "maximum": 20,
              "default": 6
            },
            "ending": {
              "allOf": [
                {
                  "$ref": "#/$defs/id"
                }
              ],
              "default": "abandoned"
            }
          }
        },
        "on_limit": {
          "allOf": [
            {
              "$ref": "#/$defs/id"
            }
          ],
          "default": "abandoned"
        }
      }
    },
    "procedural": {
      "type": "object",
      "required": [
        "premise",
        "topics",
        "atoms",
        "termination"
      ],
      "additionalProperties": false,
      "properties": {
        "premise": {
          "type": "string",
          "minLength": 1,
          "maxLength": 240
        },
        "disclosable": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/id"
          },
          "maxItems": 16,
          "uniqueItems": true,
          "default": []
        },
        "topics": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/topic"
          },
          "minItems": 1,
          "maxItems": 16
        },
        "forbidden": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/forbidden"
          },
          "maxItems": 8,
          "default": []
        },
        "goals": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/goal"
          },
          "maxItems": 8,
          "default": []
        },
        "atoms": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/atom"
          },
          "minItems": 2,
          "maxItems": 5
        },
        "horizon": {
          "$ref": "#/$defs/horizon"
        },
        "termination": {
          "$ref": "#/$defs/termination"
        }
      }
    }
  }
}
