{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022"],
    "types": ["node"],
    "noEmit": false,
    "declaration": true,
    "emitDeclarationOnly": true,
    "rootDir": "src/server",
    "outDir": "dist/server"
  },
  "include": ["src/server"],
  "exclude": ["src/server/__tests__"]
}
