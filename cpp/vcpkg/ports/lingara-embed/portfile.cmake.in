# lingara-embed @VERSION@: an overlay port over the Release's prebuilt
# lingara-embed-ffi zips (ADR 8.10.26q D2). Nothing is built from source, so
# a consumer needs no Rust toolchain. Stamped by cpp/tools/stamp-ports.sh.

# One release build serves every configuration: the C ABI carries no CRT or
# STL type, so a Debug consumer links it safely. Set here rather than in a
# triplet, the post-build check still counts the missing debug binaries.
set(VCPKG_BUILD_TYPE release)
set(VCPKG_POLICY_MISMATCHED_NUMBER_OF_BINARIES enabled)

if(VCPKG_TARGET_IS_WINDOWS)
  set(rid win-x64)
  set(sha512 @SHA512_WIN_X64@)
  vcpkg_check_linkage(ONLY_DYNAMIC_LIBRARY)
  # The DLL links its CRT statically (+crt-static). That is safe because no
  # CRT object or allocation crosses the ABI (ADR 1.10.26aa D4).
  set(VCPKG_POLICY_SKIP_CRT_LINKAGE_CHECK enabled)
elseif(VCPKG_TARGET_IS_IOS)
  # The Release carries a device slice only (ADR 1.10.26aa D7), and
  # `ios & arm64` also matches a simulator triplet.
  if(VCPKG_OSX_SYSROOT MATCHES "[Ss]imulator")
    message(FATAL_ERROR "lingara-embed ships no iOS simulator library; use a device triplet")
  endif()
  set(rid ios-arm64)
  set(sha512 @SHA512_IOS_ARM64@)
  vcpkg_check_linkage(ONLY_STATIC_LIBRARY)
elseif(VCPKG_TARGET_IS_OSX)
  # One universal library serves arm64-osx and x64-osx.
  set(rid osx)
  set(sha512 @SHA512_OSX@)
  vcpkg_check_linkage(ONLY_DYNAMIC_LIBRARY)
  set(VCPKG_POLICY_SKIP_ARCHITECTURE_CHECK enabled)
elseif(VCPKG_TARGET_IS_ANDROID)
  set(rid android-arm64)
  set(sha512 @SHA512_ANDROID_ARM64@)
  vcpkg_check_linkage(ONLY_DYNAMIC_LIBRARY)
else()
  set(rid linux-x64)
  set(sha512 @SHA512_LINUX_X64@)
  vcpkg_check_linkage(ONLY_DYNAMIC_LIBRARY)
endif()

vcpkg_download_distfile(archive
  URLS "@URL_BASE@/lingara-embed-ffi-v@VERSION@-${rid}.zip"
  FILENAME "lingara-embed-ffi-v@VERSION@-${rid}.zip"
  SHA512 ${sha512}
)
vcpkg_extract_source_archive(src ARCHIVE "${archive}" NO_REMOVE_ONE_LEVEL)

# The zip is already an install tree, its CMake package included: upstream's
# own config, so it keeps its own name (D4).
file(INSTALL "${src}/include/" DESTINATION "${CURRENT_PACKAGES_DIR}/include")
file(INSTALL "${src}/lib/" DESTINATION "${CURRENT_PACKAGES_DIR}/lib")
if(EXISTS "${src}/bin")
  file(INSTALL "${src}/bin/" DESTINATION "${CURRENT_PACKAGES_DIR}/bin")
endif()
file(INSTALL "${src}/share/lingara-embed/" DESTINATION "${CURRENT_PACKAGES_DIR}/share/${PORT}")
file(INSTALL "${CMAKE_CURRENT_LIST_DIR}/usage" DESTINATION "${CURRENT_PACKAGES_DIR}/share/${PORT}")
vcpkg_install_copyright(FILE_LIST "${src}/LICENSE")
